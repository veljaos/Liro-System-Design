@liro:registry=https://npm.pkg.github.com
auto-install-peers=true
strict-peer-dependencies=false

# Next uvozi `@swc/helpers/_/…` kroz svoj require-hook, koji ne prati pnpm-ov
# izolovani raspored. Bez podizanja u koren javlja MODULE_NOT_FOUND iako je
# paket instaliran.
public-hoist-pattern[]=*@swc*
public-hoist-pattern[]=*@next*
