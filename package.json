{
  "name": "liro-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Liro Design System - tokeni, tema, komponente i page template-i za Liro aplikacije",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:build": "pnpm --filter @liro/tokens run build:css",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "dev": "turbo run dev",
    "build": "turbo run build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.9",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "tsx": "^4.22.4",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.9.0"
}
