{
  "name": "@liro/i18n",
  "version": "0.1.0",
  "description": "Lightweight localized-label system for Liro applications",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "i18n:locales": "tsx scripts/generate-locales.ts",
    "i18n:check": "tsx scripts/check-locales.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "dayjs": ">=1.11.0",
    "next": "^16.0.0",
     "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "dayjs": "^1.11.13",
    "@types/node": "^20.19.9",
    "tsx": "^4.22.4",
    "@types/react": "catalog:",
    "next": "^16.2.9",
    "react": "^19.2.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
