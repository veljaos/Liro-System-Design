{
  "name": "@liro/preset",
  "version": "0.1.0",
  "description": "Jedan uvoz koji podešava Next.js, redosled CSS-a i niz providera za svaku Liro aplikaciju",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@liro/charts": "workspace:*",
    "@liro/data": "workspace:*",
    "@liro/dates": "workspace:*",
    "@liro/i18n": "workspace:*",
    "@liro/process": "workspace:*",
    "@liro/templates": "workspace:*",
    "@liro/theme": "workspace:*",
    "@liro/ui": "workspace:*",
    "@liro/tokens": "workspace:*"
  },
  "peerDependencies": {
    "@mantine/carousel": "catalog:",
    "@mantine/charts": "catalog:",
    "@mantine/code-highlight": "catalog:",
    "@mantine/core": "catalog:",
    "@mantine/dates": "catalog:",
    "@mantine/dropzone": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/modals": "catalog:",
    "@mantine/notifications": "catalog:",
    "@mantine/nprogress": "catalog:",
    "@mantine/schedule": "catalog:",
    "@mantine/spotlight": "catalog:",
    "@mantine/tiptap": "catalog:",
    "@tanstack/react-query": "^5.100.0",
    "@xyflow/react": "^12.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@mantine/modals": "catalog:",
    "@mantine/notifications": "catalog:",
    "@tanstack/react-query": "^5.101.1",
    "@types/react": "catalog:",
    "next": "^16.2.9",
    "react": "^19.2.4",
    "typescript": "catalog:"
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com" }
}